 "SOUNDS": [
  [
   "Vowels stay pure",
   "a is ah, e is eh, i is ee, o is oh, u is oo. Keep them short and never slide into a second sound like English does.",
   [
    "casa",
    "mesa",
    "sí",
    "solo",
    "uno"
   ]
  ],
